@Component
@RequiredArgsConstructor
@Slf4j
public class ElectionEventListener {
    
    private final IEmailService emailService;
    private final UserRepository userRepository;
    
    @Async                  // ← Run in background thread
    @EventListener          // ← Triggered by event
    public void onElectionCallCreated(ElectionCallCreatedEvent event) {
        log.info("ElectionCall created: id={}", event.call().getId());
        
        // Find all admins
        List<User> admins = userRepository.findByRole(Role.ADMIN);
        
        // Send emails to each admin
        for (User admin : admins) {
            try {
                emailService.sendElectionCallCreatedToAdmins(
                    admin.getEmail(),
                    event.call().getTitre(),
                    event.call().getDescription()
                );
                log.info("Email sent to admin: {}", admin.getEmail());
            } catch (Exception e) {
                log.error("Failed to send email to admin: {}", admin.getEmail(), e);
                // Could publish EmailFailedEvent for retry
            }
        }
    }
    
