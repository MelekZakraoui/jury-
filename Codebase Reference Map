// OffreServiceTest.java
@SpringBootTest
class OffreServiceTest {
    
    @MockBean
    private OffreRepository offreRepository;
    
    @InjectMocks
    private OffreService offreService;
    
    @Test
    void testCreerOffre() {
        // Arrange
        OffreRequest req = new OffreRequest(...);
        
        // Act
        OffreResponse response = offreService.creer(req, null, null, "user@example.com");
        
        // Assert
        assertNotNull(response.getId());
        assertEquals(req.titre(), response.getTitre());
    }
    
    @Test
    void testCreerOffreThrowsExceptionWhenCapacityInvalid() {
        // Arrange
        OffreRequest req = new OffreRequest(
            titre="Test",
            capaciteMax=-5  // Invalid!
        );
        
        // Act & Assert
        assertThrows(BadRequestException.class, () -> {
            offreService.creer(req, null, null, "user@example.com");
        });
    }
}
