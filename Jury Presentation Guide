// Version 1: Original API
// GET /api/offres/123
{
    \"id\": 123,
    \"titre\": \"Internship\",
    \"description\": \"...\",
    \"price\": 1000
}

// Later: Add \"pricePerDay\" field, deprecate \"price\"
// GET /api/v1/offres/123  ← New versioned endpoint
{
    \"id\": 123,
    \"titre\": \"Internship\",
    \"description\": \"...\",
    \"price\": 1000,  // ← Still exists for backward compat
    \"pricePerDay\": 500  // ← New field
}

// Implementation:
@RestController
@RequestMapping(\"/api/v1/offres\")
public class OffreControllerV1 {
    @GetMapping(\"/{id}\")
    public OffreResponseV1 getOffre(@PathVariable Long id) {
        Offre offre = service.getOffre(id);
        return new OffreResponseV1(
            offre.getId(),
            offre.getTitre(),
            offre.getDescription(),
            offre.getPrice(),           // Old field
            offre.getPrice() / 30       // New field (calculated)
        );
    }
}

// Old clients continue working with /api/offres (v0)
// New clients use /api/v1/offres
// When ready: Deprecate v0, make v1 primary
```

