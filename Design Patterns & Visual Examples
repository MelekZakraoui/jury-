### 2. Observer Pattern (RxJS in Angular)

#### Event Subscription Pattern

**Use Case**: Real-time notifications

```
┌─────────────────────────────────────────┐
│         Event Source                    │
│  (Database change, API call, timer)     │
└──────────────┬──────────────────────────┘
               │
               ↓
        ┌────────────────┐
        │ Observable     │
        │ (RxJS Subject) │
        └────────┬───────┘
                 │
        ┌────────┴─────────┐
        ↓                  ↓
   ┌─────────┐        ┌─────────┐
   │Component│        │Component│
   │Subscribes       │Subscribes│
   └────┬────┘        └────┬────┘
        │                  │
        ↓                  ↓
   ┌─────────┐        ┌─────────┐
   │Display  │        │Display  │
   │Updates  │        │Updates  │
   └─────────┘        └─────────┘
```

**Implementation**:
```typescript
// Service with Observable
@Injectable({ providedIn: 'root' })
export class NotificationService {
  // Subject as event source
  private notificationSubject = new Subject<Notification>();
  
  // Public Observable for consumers
  notifications$ = this.notificationSubject.asObservable();
  
  // Publish event
  notify(message: string) {
    this.notificationSubject.next({ message, time: new Date() });
  }
}

// Component 1: Subscribe and display
@Component({
  selector: 'app-notification-center',
  imports: [AsyncPipe, NgFor],
  template: `
    <div *ngFor="let notif of notifications$ | async">
      {{ notif.message }}
    </div>
  `
})
export class NotificationCenterComponent {
  notifications$ = this.notificationService.notifications$;
  
  constructor(private notificationService: NotificationService) {}
}

// Component 2: Also subscribe (reuse same observable)
@Component({
  selector: 'app-notification-badge',
  template: `<span>{{ (notifications$ | async)?.length }}</span>`
})
export class NotificationBadgeComponent {
  notifications$ = this.notificationService.notifications$;
  
  constructor(private notificationService: NotificationService) {}
}
```

**Benefits**:
- ✅ Decoupled components
- ✅ Real-time updates
- ✅ Automatic cleanup with async pipe
- ✅ Type-safe with generics

