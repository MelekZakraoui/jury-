## Before & After: Common Anti-Patterns

### Anti-Pattern 1: God Object

#### ❌ Before
```typescript
// Component doing EVERYTHING
export class UserComponent {
  users: User[];
  selectedUser: User;
  filteredUsers: User[];
  
  constructor(private http: HttpClient) {}
  
  ngOnInit() {
    this.http.get('/users').subscribe(data => {
      this.users = data;
      this.filter('active');
    });
  }
  
  filter(status: string) {
    // Filtering logic here
    this.filteredUsers = this.users.filter(...);
  }
  
  updateUser() {
    this.http.post('/users', this.selectedUser).subscribe(...);
  }
  
  deleteUser(id: number) {
    this.http.delete('/users/' + id).subscribe(...);
  }
  
  exportToCSV() {
    // CSV export logic
  }
  
  // ... more and more methods
}
```

#### ✅ After
```typescript
// Service handles logic
@Injectable()
export class UserService {
  private userSubject = new Subject<User[]>();
  users$ = this.userSubject.asObservable();
  
  constructor(private http: HttpClient) {}
  
  fetchUsers() {
    this.http.get<User[]>('/users')
      .subscribe(data => this.userSubject.next(data));
  }
  
  updateUser(user: User) {
    return this.http.post('/users', user);
  }
  
  deleteUser(id: number) {
    return this.http.delete(`/users/${id}`);
  }
}

// Filter service
@Injectable()
export class UserFilterService {
  filter(users: User[], status: string): User[] {
    return users.filter(u => u.status === status);
  }
}

// Export service
@Injectable()
export class UserExportService {
  toCSV(users: User[]): string {
    // CSV logic
  }
}

// Component just displays
@Component({
  selector: 'app-users',
  template: `<div *ngFor="let u of users$ | async">{{ u.name }}</div>`
})
export class UserComponent implements OnInit {
  users$ = this.userService.users$;
  
  constructor(private userService: UserService) {}
  
  ngOnInit() {
    this.userService.fetchUsers();
  }
}
```

### Anti-Pattern 2: Callback Hell (Nested Subscriptions)

#### ❌ Before
```typescript
// Pyramid of doom
this.userService.getUser(userId).subscribe(user => {
  this.activityService.getActivities(user.id).subscribe(activities => {
    this.notificationService.getNotifications(user.id).subscribe(notifs => {
      this.data = {
        user,
        activities,
        notifications: notifs
      };
    });
  });
});
```

#### ✅ After
```typescript
// Using RxJS operators
this.userService.getUser(userId).pipe(
  switchMap(user => 
    this.activityService.getActivities(user.id).pipe(
      map(activities => ({ user, activities }))
    )
  ),
  switchMap(({ user, activities }) =>
    this.notificationService.getNotifications(user.id).pipe(
      map(notifs => ({ user, activities, notifs }))
    )
  ),
  takeUntil(this.destroy$)
).subscribe(data => {
  this.data = data;
});
```

#### Even Better: combineLatest
```typescript
// Parallel loading
combineLatest([
  this.userService.getUser(userId),
  this.activityService.getActivities(userId),
  this.notificationService.getNotifications(userId)
]).pipe(
  map(([user, activities, notifications]) => ({
    user, activities, notifications
  })),
  takeUntil(this.destroy$)
).subscribe(data => {
  this.data = data;
});
```

