// Service Layer - Business Logic
@Service
@Transactional
public class InscriptionService {
    
    @Autowired
    private InscriptionRepository repository;
    
    @Autowired
    private NotificationService notificationService;
    
    @Autowired
    private ApplicationEventPublisher eventPublisher;
    
    // Create inscription with validation
    public InscriptionDTO createInscription(InscriptionDTO dto) {
        // Validation
        if (repository.existsByEmail(dto.getEmail())) {
            throw new DuplicateEmailException("Email already exists");
        }
        
        // Transform DTO to Entity
        Inscription entity = mapToEntity(dto);
        entity.setStatus(InscriptionStatus.PENDING);
        
        // Save to database
        Inscription saved = repository.save(entity);
        
        // Trigger notification event
        eventPublisher.publishEvent(
            new InscriptionCreatedEvent(saved)
        );
        
        return mapToDTO(saved);
    }
    
    // Update status and notify
    public InscriptionDTO updateStatus(Long id, String status) {
        Inscription inscription = repository.findById(id)
            .orElseThrow(() -> new ResourceNotFoundException("Not found"));
        
        inscription.setStatus(InscriptionStatus.valueOf(status));
        Inscription updated = repository.save(inscription);
        
        // Send notification to member
        notificationService.notifyMember(updated);
        
        return mapToDTO(updated);
    }
}

