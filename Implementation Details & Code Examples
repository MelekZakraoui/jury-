// Listener - Handles event
@Component
public class InscriptionEventListener {
    
    @Autowired
    private NotificationService notificationService;
    
    @EventListener
    @Async
    public void onInscriptionCreated(InscriptionCreatedEvent event) {
        Inscription inscription = event.getInscription();
        
        // Send confirmation to member
        notificationService.sendEmail(
            inscription.getEmail(),
            "Registration Confirmation",
            buildConfirmationTemplate(inscription)
        );
        
        // Notify admins
        notificationService.notifyAdmins(
            "New inscription: " + inscription.getFullName()
        );
        
        // Save notification record
        notificationService.saveNotification(
            inscription.getId(),
            NotificationType.REGISTRATION_CREATED,
            "Inscription créée pour: " + inscription.getFullName()
        );
    }
}

// Notification Service
@Service
@Transactional
public class NotificationService {
    
    @Autowired
    private EmailService emailService;
    
    @Autowired
    private NotificationRepository repository;
    
    @Autowired
    private WebSocketService webSocketService;
    
    // Send email notification
    public void sendEmail(String to, String subject, String content) {
        try {
            SimpleMailMessage message = new SimpleMailMessage();
            message.setTo(to);
            message.setSubject(subject);
            message.setText(content);
            message.setFrom("noreply@amicalestar.tn");
            
            emailService.send(message);
        } catch (Exception e) {
            log.error("Failed to send email", e);
        }
    }
    
    // Notify all admins
    public void notifyAdmins(String message) {
        // Get all admin users
        List<User> admins = userRepository.findByRole("BUREAU");
        
        // Save notification for each admin
        admins.forEach(admin -> {
            saveNotification(
                admin.getId(),
                NotificationType.ADMIN_ALERT,
                message
            );
        });
        
        // Broadcast to connected WebSocket clients
        webSocketService.broadcastToAdmins(
            new NotificationMessage(message, NotificationType.ADMIN_ALERT)
        );
    }
    
    // Save notification to database
    public void saveNotification(
            Long userId, 
            NotificationType type, 
            String message) {
        
        NotificationEntity entity = new NotificationEntity();
        entity.setUserId(userId);
        entity.setType(type);
        entity.setMessage(message);
        entity.setReadAt(null); // Mark as unread
        entity.setCreatedAt(LocalDateTime.now());
        
        repository.save(entity);
    }
}

// WebSocket Service - Real-time updates
@Component
public class WebSocketService {
    
    @Autowired
    private SimpMessagingTemplate messagingTemplate;
    
    public void broadcastToAdmins(NotificationMessage message) {
        // Send to all subscribed admins
        messagingTemplate.convertAndSend(
            "/topic/admin-notifications",
            message
        );
    }
    
    public void sendToUser(Long userId, NotificationMessage message) {
        // Send to specific user
        messagingTemplate.convertAndSendToUser(
            userId.toString(),
            "/queue/notifications",
            message
        );
    }
}

// Frontend WebSocket subscription
@Injectable({ providedIn: 'root' })
export class WebSocketService {
  
  private stompClient: StompClient;
  private notificationSubject = new Subject<Notification>();
  
  connect(): Observable<Notification> {
    const socket = new SockJS('/ws');
    this.stompClient = Stomp.over(socket);
    
    this.stompClient.connect({}, () => {
      // Subscribe to admin notifications
      this.stompClient.subscribe(
        '/topic/admin-notifications',
        (msg) => {
          const notification = JSON.parse(msg.body);
          this.notificationSubject.next(notification);
        }
      );
    });
    
    return this.notificationSubject.asObservable();
  }
}
