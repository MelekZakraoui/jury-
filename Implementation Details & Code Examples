// Service
@Service
@Transactional
public class SondageService {
    
    @Autowired
    private SondageRepository sondageRepository;
    
    @Autowired
    private VoteRepository voteRepository;
    
    @Autowired
    private UserService userService;
    
    // Create sondage
    public SondageDTO createSondage(CreateSondageDTO dto) {
        Sondage sondage = new Sondage();
        sondage.setTitle(dto.title);
        
        sondage.setQuestions(dto.questions.stream()
            .map(qDto -> {
                Question q = new Question();
                q.setText(qDto.text);
                q.setAnswers(qDto.answers);
                return q;
            })
            .collect(Collectors.toList())
        );
        
        Sondage saved = sondageRepository.save(sondage);
        return mapToDTO(saved);
    }
    
    // Record vote
    public void recordVote(
            Long sondageId,
            Long questionId,
            Integer answerIndex,
            Long userId) {
        
        Sondage sondage = sondageRepository.findById(sondageId)
            .orElseThrow(() -> new ResourceNotFoundException());
        
        User user = userService.findById(userId);
        
        // Check if already voted
        if (voteRepository.existsBySondageAndUserAndQuestionId(
                sondage, user, questionId)) {
            throw new IllegalArgumentException("Already voted");
        }
        
        Vote vote = new Vote();
        vote.setSondage(sondage);
        vote.setUser(user);
        vote.setQuestionId(questionId);
        vote.setAnswerIndex(answerIndex);
        
        voteRepository.save(vote);
    }
    
    // Get results
    public SondageResultsDTO getResults(Long sondageId) {
        Sondage sondage = sondageRepository.findById(sondageId)
            .orElseThrow();
        
        SondageResultsDTO results = new SondageResultsDTO();
        results.setSondageId(sondageId);
        results.setTitle(sondage.getTitle());
        
        results.setQuestionResults(
            sondage.getQuestions().stream()
                .map(question -> {
                    QuestionResultDTO qResult = new QuestionResultDTO();
                    qResult.setQuestionId(question.getId());
                    qResult.setText(question.getText());
                    
                    // Count votes for each answer
                    List<Vote> votes = voteRepository.findBySondageAndQuestionId(
                        sondage, question.getId()
                    );
                    
                    qResult.setAnswerCounts(
                        IntStream.range(0, question.getAnswers().size())
                            .mapToObj(i -> {
                                long count = votes.stream()
                                    .filter(v -> v.getAnswerIndex() == i)
                                    .count();
                                return new AnswerResultDTO(
                                    question.getAnswers().get(i),
                                    count
                                );
                            })
                            .collect(Collectors.toList())
                    );
                    
                    return qResult;
                })
                .collect(Collectors.toList())
        );
        
        return results;
    }
}

