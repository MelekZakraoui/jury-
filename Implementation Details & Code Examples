export class InscriptionsComponent implements OnInit {
  form: FormGroup;
  inscriptions$: Observable<Page<Inscription>>;
  loading$ = new BehaviorSubject(false);

  constructor(
    private fb: FormBuilder,
    private service: InscriptionService
  ) {
    this.form = this.initializeForm();
  }

  ngOnInit() {
    // Load inscriptions on init
    this.loadInscriptions();
  }

  // Form definition with validation
  private initializeForm(): FormGroup {
    return this.fb.group({
      firstName: ['', [Validators.required, Validators.minLength(2)]],
      lastName: ['', [Validators.required, Validators.minLength(2)]],
      email: ['', [Validators.required, Validators.email]],
      phoneNumber: ['', [Validators.pattern(/^\d{8,}$/)]],
      joinDate: ['', Validators.required],
      status: ['PENDING', Validators.required]
    });
  }

  // Submit form
  onSubmit() {
    if (!this.form.valid) return;

    this.loading$.next(true);
    
    this.service.createInscription(this.form.value)
      .pipe(
        finalize(() => this.loading$.next(false)),
        tap(() => {
          this.form.reset();
          this.loadInscriptions(); // Refresh list
        })
      )
      .subscribe({
        error: (err) => console.error(err)
      });
  }

  // Load inscriptions with pagination
  private loadInscriptions(page = 0) {
    this.inscriptions$ = this.service.getInscriptions(page);
  }

  // Change member status
  updateStatus(id: number, newStatus: string) {
    this.service.updateInscriptionStatus(id, newStatus)
      .pipe(tap(() => this.loadInscriptions()))
      .subscribe();
  }
}
